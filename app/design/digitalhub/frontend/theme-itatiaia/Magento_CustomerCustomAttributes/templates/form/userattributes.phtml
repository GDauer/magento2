?>

<?php if($block->getParentBlock() && $block->getParentBlock()->getFormData()): ?>
<div class="field choice show-empresa">
    <input type="checkbox" name="use_empresa_fields" title="<?= /* @escapeNotVerified */ __('Sumar datos de empresa') ?>" value="1" id="use_empresa_fields"<?php if ($block->getParentBlock()->getFormData()->getUseEmpresaFields()): ?> checked="checked"<?php endif; ?> class="checkbox"/>
    <label for="use_empresa_fields" class="label"><span><?= /* @escapeNotVerified */ __('Sumar datos de empresa') ?></span></label>
</div>
<?php endif; ?>

<?php if ($block->hasUserDefinedAttributes()): ?>
    <?php if ($block->isShowContainer()): ?>
    <fieldset class="fieldset">
    <?php endif;?>
    <?php foreach ($block->getUserDefinedAttributes() as $attribute):?>
        <?php $attributeContent = $block->getAttributeHtml($attribute);?>
        <?php if ($attributeContent): ?>
            <?= /* @escapeNotVerified */ $attributeContent ?>
        <?php endif;?>
    <?php endforeach;?>
    <?php if ($block->isShowContainer()): ?>
    </fieldset>
    <?php endif;?>
<?php endif; ?>

<script type="text/javascript">
    require([
        'jquery'
    ], function($){
        $('input[name=use_empresa_fields]').change(function(){
            if($(this).attr('checked')){
                $('.field-razon_social, .field-empresa, .field-ruc').show();
            } else {
                $('.field-razon_social, .field-empresa, .field-ruc').hide();
            }
        })
    })
</script>
