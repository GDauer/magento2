/** @var \Magento\CatalogWidget\Block\Product\ProductsList $block */
?>
<?php if ($exist = ($block->getProductCollection() && $block->getProductCollection()->getSize())): ?>
  <script>
  require(['jquery'],function($){
    jQuery(document).ready(function() {
      jQuery(".home-products-list .product-items").addClass("owl-carousel");
    });
    jQuery('.product-image-wrapper').hover(function() {
      jQuery(this).children('.hover_image').css('display', 'block');
      jQuery(this).children('.hover_image').stop(true).fadeTo(200,1);
    }, function() {
      jQuery(this).children('.hover_image').fadeOut();
      jQuery(this).children('.hover_image').css('display', 'none');
    });
  });
</script>

<?php
$type = 'widget-product-grid';

$mode = 'grid';

$image = 'new_products_content_widget_grid';
$items = $block->getProductCollection()->getItems();

$showWishlist = true;
$showCompare = true;
$showCart = true;
$templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::DEFAULT_VIEW;
$description = true;
$_helper = $this->helper('Magento\Catalog\Helper\Output');
$price_with_discount_active = $this->getConfig('digitalhub_additionalprices_payment_discount/active');
$_imagehelper = $this->helper('Magento\Catalog\Helper\Image');
$hoverimg = 'category_page_grid_hover';
$hoverimg = 'category_page_list_hover';
?>
<div class="block widget block-products-list <?= /* @noEscape */ $mode ?>">
  <?php if ($block->getTitle()): ?>
    <div class="block-title">
      <strong><?= $block->escapeHtml(__($block->getTitle())) ?></strong>
    </div>
  <?php endif ?>
  <div class="block-content">
    <?= /* @noEscape */ '<!-- ' . $image . '-->' ?>
    <div class="products-<?= /* @noEscape */ $mode ?> <?= /* @noEscape */ $mode ?>">
      <ol class="product-items <?= /* @noEscape */ $type ?>">
        <?php $iterator = 1; ?>
        <?php foreach ($items as $_item): ?>
          <?php if ($iterator++ != 1): ?></li><?php endif ?>
          <li class="product-item">
            <div class="product-item-info">
              <?php /* if($product->getPriceInfo()->getPrice('final_price')->getAmount()->getBaseAmount() < $product->getPriceInfo()->getPrice('regular_price')->getAmount()->getValue()) : ?>
              -<?= (int)(100 - ($product->getPriceInfo()->getPrice('final_price')->getAmount()->getBaseAmount() * 100 / $product->getPriceInfo()->getPrice('regular_price')->getAmount()->getValue()))?>%
              <?php endif; */ ?>
              <?php if ($showWishlist || $showCompare): ?>
                <div class="actions-secondary" data-role="add-to-links">
                  <?php if ($this->helper('Magento\Wishlist\Helper\Data')->isAllow() && $showWishlist): ?>
                    <a href="#"
                    data-post='<?= /* @noEscape */ $block->getAddToWishlistParams($_item) ?>' class="action towishlist" data-action="add-to-wishlist" title="<?= $block->escapeHtmlAttr(__('Add to Wish List')) ?>">
                    <span><?= $block->escapeHtml(__('Add to Wish List')) ?></span>
                  </a>
                <?php endif; ?>
                <?php if ($block->getAddToCompareUrl() && $showCompare): ?>
                  <?php $compareHelper = $this->helper('Magento\Catalog\Helper\Product\Compare');?>
                  <a href="#" class="action tocompare" data-post='<?= /* @noEscape */ $compareHelper->getPostDataParams($_item) ?>' title="<?= $block->escapeHtmlAttr(__('Add to Compare')) ?>">
                    <span><?= $block->escapeHtml(__('Add to Compare')) ?></span>
                  </a>
                <?php endif; ?>
              </div>
            <?php endif; ?>

            <?php if(date('Y-m-d H:i:s') >= $_item->getData('news_from_date') && date('Y-m-d H:i:s') <= $_item->getData('news_to_date')) :?>
              <span class="tag-new">Novo</span>
            <?php endif ;?>

            <?php if($_item->getFinalPrice() < $_item->getPrice()) : ?>
              <span class="tag-desc">-<?= (int)(100 - ($_item->getFinalPrice() * 100 / $_item->getPrice()))?>%</span>
            <?php endif; ?>

            <a href="<?= /* @escapeNotVerified */ $_item->getProductUrl() ?>" class="product photo product-item-photo" tabindex="-1">
              <?php
              $productImage = $_imagehelper->init($_item, $image);
              $productImageUrl = $productImage->getUrl();
              $productHoverImage = $_imagehelper->init($_item, $hoverimg);
              $productHoverImageUrl = $productHoverImage->getUrl();
              ?>
              <span class="product-image-container">
                <span class="product-image-wrapper">
                  <img class="default_image" src="<?php echo $productImageUrl; ?>" alt="<?php echo $productImage->getLabel(); ?>"/>
                  <?php if($_item->getHoverImage()): ?>
                    <?php if($productImageUrl != str_replace("/thumbnail/","/small_image/",$productHoverImageUrl)): ?>
                      <img class="hover_image" src="<?php echo $productHoverImageUrl; ?>" alt="<?php echo $productHoverImage->getLabel(); ?>" style="opacity: 1; display: none;" />
                    <?php endif; ?>
                  <?php endif; ?>
                </span>
              </span>
            </a>
            <div class="product-item-details">
              <strong class="product-item-name">
                <a title="<?= $block->escapeHtml($_item->getName()) ?>"
                  href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>"
                  class="product-item-link">
                  <?= $block->escapeHtml($_item->getName()) ?>
                </a>
              </strong>

              <?php echo $block->getProductPriceHtml($_item, $type); ?>

              <div class="preco-a-vista">
                <?php
                echo $this->getLayout()
                ->createBlock('\DigitalHub\AdditionalPrices\Block\Product\Additional')
                ->setTemplate('DigitalHub_AdditionalPrices::product/additional_prices.phtml')
                ->setProduct($_item)
                ->toHtml();
                ?>
              </div>


              <div class="preco-parcelado">
                <?php
                echo $this->getLayout()
                ->createBlock('\DigitalHub\AdditionalPrices\Block\Product\Additional')
                ->setTemplate('DigitalHub_AdditionalPrices::product/additional_prices.phtml')
                ->setProduct($_item)
                ->toHtml();
                ?>
              </div>

              <?php if ($templateType): ?>
                <?= $block->getReviewsSummaryHtml($_item, $templateType) ?>
              <?php endif; ?>
              <?php if ($showWishlist || $showCompare || $showCart): ?>
                <div class="product-item-actions">
                  <div class="wrp-short">
                  <?php if ($_item->getShortDescription()): ?>
                      <?php /* @escapeNotVerified */ echo $_helper->productAttribute($_item, $_item->getShortDescription(), 'short_description'); ?>
                  <?php endif; ?>
                  </div>
                  <?php if ($showCart): ?>
                    <div class="actions-primary">
                      <?php if ($_item->isSaleable()): ?>
                        <?php if ($_item->getTypeInstance()->hasRequiredOptions($_item)): ?>
                          <button class="action tocart primary" onClick="self.location='<?= $block->escapeUrl($block->getProductUrl($_item)) ?>'" type="button" title="<?= $block->escapeHtmlAttr(__('Comprar agora')) ?>">
                            <span><?= $block->escapeHtml(__('Comprar agora')) ?></span>
                          </button>
                        <?php else: ?>
                          <?php
                          $postDataHelper = $this->helper('Magento\Framework\Data\Helper\PostHelper');
                          $postData = $postDataHelper->getPostData($block->getAddToCartUrl($_item), ['product' => $_item->getEntityId()])
                          ?>
                          <button class="action tocart primary" onClick="self.location='<?= $block->escapeUrl($block->getProductUrl($_item)) ?>'" type="button" title="<?= $block->escapeHtmlAttr(__('Comprar agora')) ?>">
                            <span><?= $block->escapeHtml(__('Comprar agora')) ?></span>
                          </button>
                        <?php endif; ?>
                      <?php else: ?>
                        <?php if ($_item->getIsSalable()): ?>
                          <div class="stock available"><span><?= $block->escapeHtml(__('In stock')) ?></span></div>
                        <?php else: ?>
                          <div class="stock unavailable"><span><?= $block->escapeHtml(__('Out of stock')) ?></span></div>
                        <?php endif; ?>
                      <?php endif; ?>
                    </div>
                  <?php endif; ?>
                </div>
              <?php endif; ?>
            </div>
          </div>
          <?= ($iterator == count($items)+1) ? '</li>' : '' ?>
        <?php endforeach ?>
      </ol>
    </div>
    <?= $block->getPagerHtml() ?>
  </div>
  <script>
  require([
    'jquery',
    'owlcarousel'
  ], function () {
    'use strict';
    jQuery.noConflict();
    jQuery(".home-products-list .owl-carousel").owlCarousel({
      loop: true,
      nav: true,
      dots: true,
      lazyLoad: true,
      //center: true,
      margin: 20,
      responsive:{
        0:{
          items:2
        },
        600:{
          items:4
        },
        1000:{
          items:4
        }
      }
    })
  });
  </script>
</div>
<?php endif;?>
