<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- <referenceBlock name="product.info.price.additionals" remove="true" /> -->
        <referenceBlock name="product.info.details">
            <block class="Magento\Framework\View\Element\Template" name="grouped.items" as="grouped_items" template="Magento_Catalog::product/view/grouped/items.phtml" group="detailed_info" before="product.info.description">
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Módulos inclusos</argument>
                </arguments>
            </block>
            <block class="Magento\Catalog\Block\Product\View\Description" name="product.info.description" as="description" template="Magento_Catalog::product/view/attribute.phtml" group="detailed_info">
                <arguments>
                    <argument name="at_call" xsi:type="string">getDescription</argument>
                    <argument name="at_code" xsi:type="string">description</argument>
                    <argument name="css_class" xsi:type="string">description</argument>
                    <argument name="at_label" xsi:type="string">none</argument>
                    <argument name="title" translate="true" xsi:type="string">Descrição</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
