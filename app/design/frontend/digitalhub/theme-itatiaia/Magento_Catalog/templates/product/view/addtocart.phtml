/** @var $block \Magento\Catalog\Block\Product\View */
?>
<?php $_product = $block->getProduct(); ?>

<?php $buttonTitle = __('Comprar'); ?>

<?php if ($_product->isAvailable()): ?>
<div class="box-tocart" data-mage-init='{"Magento_Catalog/add-to-cart-disable":{}}'>
    <div class="fieldset">
        <?php if ($block->shouldRenderQuantity()): ?>
        <div class="field qty">
            <label class="label" for="qty"><span><?= /* @escapeNotVerified */ __('Quantidade') ?></span></label>
            <div class="control">
              <a href="javascript:void(0)" class="qty-dec">-</a>
              <input type="number"
                     name="qty"
                     id="qty"
                     value="<?php /* @escapeNotVerified */ echo $block->getProductDefaultQty() * 1 ?>"
                     title="<?php /* @escapeNotVerified */ echo __('Quantidade') ?>"
                     class="input-text qty"
                     data-validate="<?php echo $block->escapeHtml(json_encode($block->getQuantityValidators())) ?>"
                     />
              <a href="javascript:void(0)" class="qty-inc">+</a>
            </div>
        </div>
        <?php endif; ?>

        <div class="actions">
                <?php
                    $volts = $_product->getCustomAttribute('tens_o');
                    $voltsValue = $_product->getAttributeText('tens_o');

                    if(!empty($volts) && !empty($volts->getValue()) && $voltsValue === '127V' ) :
                ?>
                    <button type="submit"
                        title="<?= /* @escapeNotVerified */ $buttonTitle ?>"
                        class="action primary tocart trigger_modal">
                        <span><?= /* @escapeNotVerified */ $buttonTitle ?></span>
                    </button>
                <?php else: ?>
                    <button type="submit"
                        title="<?= /* @escapeNotVerified */ $buttonTitle ?>"
                        class="action primary tocart itatiaia-tocart"
                        id="product-addtocart-button">
                        <span><?= /* @escapeNotVerified */ $buttonTitle ?></span>
                    </button>
                <?php endif; ?>
                
            
            <?= $block->getChildHtml('', true) ?>
        </div>

        <?php
            echo $this->getLayout()
                ->createBlock('\DigitalHub\EstimateShipping\Block\Estimate')
                ->setTemplate('DigitalHub_EstimateShipping::product/estimate-shipping.phtml')
                ->toHtml()
        ?>
    </div>
</div>
<?php endif; ?>
<?php if ($block->isRedirectToCartEnabled()) : ?>
<script type="text/x-magento-init">
    {
        "#product_addtocart_form": {
            "Magento_Catalog/product/view/validation": {
                "radioCheckboxClosest": ".nested"
            }
        }
    }
</script>
<?php else : ?>
<script type="text/x-magento-init">
    {
        "#product_addtocart_form": {
            "Magento_Catalog/js/validate-product": {}
        }
    }
</script>
<?php endif; ?>

<div id="triggerModalVolts" class="modal_volts d_none">
    <div class="modal_content">
        <img class="modal_details modal_close btn_close" src="<?php echo $this->getViewFileUrl('images/modal_volts/modal_close.svg'); ?>" alt="Fechar">
        
        <p>Você confirma que<br> deseja comprar um<br> produto 127V?</p>
        <button type="submit"
            title="Confirmar"
            class="action primary tocart itatiaia-tocart"
            id="product-addtocart-button">
            <span>Confirmar</span>
        </button>
    
        <img class="modal_details top_left" src="<?php echo $this->getViewFileUrl('images/modal_volts/top_left.svg'); ?>" alt="Seta topo esquerda">
        <img class="modal_details top_right" src="<?php echo $this->getViewFileUrl('images/modal_volts/top_right.svg'); ?>" alt="Seta topo direito">
        <img class="modal_details bottom_left" src="<?php echo $this->getViewFileUrl('images/modal_volts/bottom_left.svg'); ?>" alt="Seta base esquerda">
        <img class="modal_details bottom_right" src="<?php echo $this->getViewFileUrl('images/modal_volts/bottom_right.svg'); ?>" alt="Seta base direita">
    </div>
</div>

<script type="text/x-magento-init">
    {
        "#triggerModalVolts": {
            "Webjump_ModalVolts/js/modal_volts": {}
        }
    }
</script>

<script>
    require(['jquery'], function($) {
      var $currentQTY=parseInt($('#qty').val());
      jQuery(".qty-inc").click(function(){
        $currentQTY=$currentQTY+1;
        jQuery('#qty').val($currentQTY);
      });

      jQuery(".qty-dec").click(function(){
        $currentQTY=$currentQTY-1;
        if ($currentQTY<1){
          $currentQTY=1;
        }
        jQuery('#qty').val($currentQTY);
      });
    });
</script>
