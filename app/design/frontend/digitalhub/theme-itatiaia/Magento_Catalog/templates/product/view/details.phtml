<?php
$product = $block->getProduct();
$priceHelper = $this->helper('Magento\Framework\Pricing\Helper\Data');
$_imagehelper = $this->helper('Magento\Catalog\Helper\Image');
?>

<?php $buttonTitle = __('Comprar'); ?>

<?php $block->setPreconfiguredValue(); ?>
<?php $_associatedProducts = $block->getAssociatedProducts(); ?>
<?php $_hasAssociatedProducts = count($_associatedProducts) > 0; ?>

<?php if ($detailedInfoGroup = $block->getGroupChildNames('detailed_info', 'getChildHtml')):?>
<div class="product info detailed">
    <?php $layout = $block->getLayout(); ?>
    <div class="product data items" data-mage-init='{"tabs":{"openedState":"active"}}'>

        <?php if($block->getProduct()->getTypeId() == 'grouped'): ?>
            <?php $html = $layout->renderElement('grouped.items'); ?>
            <div class="data item title"
                aria-labeledby="tab-label-grouped_items-title"
                data-role="collapsible" id="tab-label-grouped_items">
                <a class="data switch"
                    tabindex="-1"
                    data-toggle="switch"
                    href="#grouped_items"
                    id="tab-label-grouped_items-title">
                    Módulos inclusos
                </a>
            </div>
            <div class="data item content" id="grouped_items" data-role="content">
                <?= /* @escapeNotVerified */ $html ?>
            </div>
        <?php endif; ?>

        <?php foreach ($detailedInfoGroup as $name): ?>

            <?php if($name == 'grouped.items') continue; ?>
            <?php if($block->getProduct()->getTypeId() == 'grouped' && $name == 'product.info.description') continue; ?>
            <?php if($block->getProduct()->getTypeId() == 'grouped' && $name == 'product.attributes') continue; ?>

            <?php
            $html = $layout->renderElement($name);
            if (!trim($html)) {
                continue;
            }
            $alias = $layout->getElementAlias($name);
            $label = $block->getChildData($alias, 'title');
            ?>
            <div class="data item title"
                aria-labeledby="tab-label-<?= /* @escapeNotVerified */ $alias ?>-title"
                data-role="collapsible" id="tab-label-<?= /* @escapeNotVerified */ $alias ?>">
                <a class="data switch"
                    tabindex="-1"
                    data-toggle="switch"
                    href="#<?= /* @escapeNotVerified */ $alias ?>"
                    id="tab-label-<?= /* @escapeNotVerified */ $alias ?>-title">
                    <?= /* @escapeNotVerified */ $label ?>
                </a>
            </div>
            <div class="data item content" id="<?= /* @escapeNotVerified */ $alias ?>" data-role="content">
                <?= /* @escapeNotVerified */ $html ?>
            </div>
        <?php endforeach;?>
    </div>
<?php endif; ?>

<!-- Início - Min Demais Produto    -->

<div class="float-min">
    <div class="min-in">
        <?php if ($product->getCustomAttribute( 'imagem_miniatura' )): ?>
            <?php
            $productImageAttr = $product->getCustomAttribute( 'imagem_miniatura' );
            $productImage = $this->helper('Magento\Catalog\Helper\Image')
            ->init($product, 'imagem_miniatura')
            ->setImageFile($productImageAttr->getValue());
            ?>
            <img src="<?= $productImage->getUrl() ?>" alt="<?= $block->escapeHtml($product->getTitle()) ?>" />
        <?php endif; ?>
        <h1 class="product-name"><?= $product->getName(); ?></h1>
        <?php if ($product->isSaleable()): ?>
            <div class="wrp-price">
                <div class="price-box">
                    <div class="wrp-oldprice">
                        <span class="old-price">
                            <span class="price">R$59,00</span>
                        </span>
                        <div class="wrp-desc">
                            <span class="tag-desc">16%</span>
                        </div>
                        <div class="clear"></div>
                        <span class="special-price">
                            <span class="price">
                                R$49,00
                            </span>
                        </span>
                    </div>
                </div>
                <div class="preco-a-vista">
                    <p class="price-with-discount"><span>R$41,65</span> à vista no boleto</p>
                    <p class="installments-price"> ou <span>4x</span> de <span>R$12,25</span> sem juros</p>
                </div>
            </div>

            <div class="box-tocart">
                <?php
                $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
                $listBlock = $objectManager->get('\Magento\Catalog\Block\Product\ListProduct');
                $addToCartUrl =    $listBlock->getAddToCartUrl($product);
                ?>

                <form data-role="tocart-form" action="<?= $addToCartUrl; ?>" method="post">
                    <?= $block->getBlockHtml('formkey')?>
                    <div class="btn">
                        <button type="submit" title="Add to Cart" class="action tocart primary">
                            <span>COMPRE AGORA</span>
                        </button>
                    </div>
                </form>
            </div>
        <?php endif; ?>
    </div>
</div>
