                    <p>Leve o conjunto selecionado por apenas:</p>
                    <div class="price-box">
                        <div class="wrp-oldprice">
                            <span class="old-price">
                                <span class="price old-price-grouped"></span>
                            </span>
                            <div class="wrp-desc">
                                <span class="tag-desc discount-grouped"></span>
                            </div>
                            <div class="clear"></div>
                            <span class="special-price">
                                <span class="price final-price-grouped"></span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="box-tocart">
                    <div class="btn">
                        <button title="Add to Cart"
                                onclick="jQuery('#product-addtocart-button').trigger('mousedown'); return false;"
                                class="action tocart primary">
                            <span>COMPRE AGORA</span>
                        </button>
                    </div>
                </div>
            <?php endif; ?>
        </div>
				<div class="bannerout">
					<?php echo $this->getLayout()->createBlock('Magento\Cms\Block\Block')->setBlockId('bannerbbb')->toHtml(); ?>
				</div>
    </div>

    <script>
        <?php
        $associatedProducts = $product->getTypeInstance(true)->getAssociatedProducts($product);
        $associatedConfig = [];
        foreach ($associatedProducts as $item) {
            $childProduct = ObjectManager::getInstance()->get('\Magento\Catalog\Model\Product')->load($item->getId());
            $associatedConfig[] = [
                'name' => $item->getName(),
                'qty' => (int)$item->getQty(),
                'id' => $item->getId(),
                'price' => $groupedCatalogRuleHelper->getRegularPrice($childProduct, $product),
                'final_price' => $groupedCatalogRuleHelper->getFinalPrice($childProduct, $product)
            ];
        }
        ?>
        var associatedConfig = <?php echo json_encode($associatedConfig) ?>;
        var priceFormat = {
            "pattern": "R$ %s",
            "precision": 2,
            "requiredPrecision": 2,
            "decimalSymbol": ",",
            "groupSymbol": ".",
            "groupLength": 3,
            "integerRequired": false
        };
        window.scrollToGroupedItems = function () {
            // window.scrollTo(0, jQuery('a[name=grouped-items]').offset().top - 150);
            jQuery("html, body").stop().animate({scrollTop: jQuery('a[name=grouped-items]').offset().top - 150}, 500, 'swing');
            return false;
        };
        require([
            'jquery',
            'Magento_Catalog/js/price-utils'
        ], function ($, priceUtils) {

            // Configurações de checkbox e qty dos itens do agrupado
            $('.super-group-qty').change(function () {
                var itemId = $(this).attr('rel');
                var superInput = $('input#super_group_' + itemId);
                var checkSuper = $('#check_super_' + itemId);
                var qty = $(this).val();
                if (checkSuper.attr('checked')) {
                    superInput.val(qty).trigger('change');
                    updateSidebar()
                }
            });

            $('.super-group-qty').each(function () {
                var input = $(this);
                var decButton = input.parents('.field.qty:first').find('a.qty-dec');
                var incButton = input.parents('.field.qty:first').find('a.qty-inc');
                decButton.click(function () {
                    var qty = parseInt(input.val());
                    input.val(qty > 1 ? qty - 1 : 1).trigger('change');
                    return false;
                });
                incButton.click(function () {
                    var qty = parseInt(input.val());
                    input.val(qty + 1).trigger('change');
                    return false;
                })
            });

            $('.check-super-group').change(function () {
                var itemId = $(this).attr('rel');
                var superInput = $('input#super_group_' + itemId);
                if ($(this).attr('checked')) {
                    var qty = $('input#super_group_qty_' + itemId).val();
                    superInput.val(qty)
                } else {
                    superInput.val(0)
                }
                updateSidebar();
            });

            $('.wrp-dtls a').click(function () {
                $(this).toggleClass('active');
                $(this).parents('.item-out:first').find('.min-dtls').toggle();
                return false;
            });

            $('.min-dtls .nav-tabs li a').click(function () {
                $(this).parents('.nav-tabs:first').find('li').removeClass('active');
                $(this).parents('.nav-tabs:first').find('li').removeClass('active');
                $(this).parents('li:first').addClass('active');
                $(this).parents('.min-dtls:first').find('section').removeClass('active').addClass('hide');
                $($(this).attr('href')).removeClass('hide').addClass('active');
                return false;
            });

            // Configurações do float lateral
            function updateSidebar() {
                var oldPrice = 0;
                var finalPrice = 0;
                var discount = 0;

                var checkedIds = [];
                $('.check-super-group').each(function () {
                    if ($(this).attr('checked')) {
                        var itemId = $(this).attr('rel');
                        checkedIds.push(itemId)
                    }
                });

                $('#selected-grouped').html('');
                $(associatedConfig).each(function (i, item) {
                    if (checkedIds.indexOf(item.id) !== -1) {
                        var qty = $('.super-group-qty[rel="' + item.id + '"]').val();
                        var li = '<li id="selected-grouped-item-' + item.id + '">' + qty + 'x ' + item.name + '</li>';
                        $('#selected-grouped').append(li);

                        oldPrice = oldPrice + (parseFloat(item.price) * qty);
                        finalPrice = finalPrice + (parseFloat(item.final_price) * qty)
                    }
                });

                discount = Math.ceil(((finalPrice * 100) / oldPrice) - 100);

                $('.old-price-grouped').html(priceUtils.formatPrice(oldPrice, priceFormat));
                $('.discount-grouped').html(discount + '%');

                if (oldPrice > finalPrice) {
                    $('.old-price-grouped').show()
                } else {
                    $('.old-price-grouped').hide()
                }
                if (discount) {
                    $('.discount-grouped').show()
                } else {
                    $('.discount-grouped').hide()
                }

                if (checkedIds.length) {
                    $('#product-addtocart-button, .box-tocart .action.tocart').removeAttr('disabled')
                } else {
                    $('#product-addtocart-button, .box-tocart .action.tocart').attr('disabled', 'disabled')
                }
            }
            updateSidebar()
        })
    </script>
<?php endif; ?>
