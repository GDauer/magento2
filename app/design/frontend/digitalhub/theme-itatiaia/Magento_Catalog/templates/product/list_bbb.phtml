?>
<?php
/**
 * Product list template
 *
 * @var $block \Magento\Catalog\Block\Product\ListProduct
 */
?>
<?php
$_productCollection = $block->getLoadedProductCollection();
$_helper = $this->helper('Magento\Catalog\Helper\Output');
$_imagehelper = $this->helper('Magento\Catalog\Helper\Image');
$hoverimg = 'category_page_grid_hover';
$hoverimg = 'category_page_list_hover';
?>
<script>
    require([
        'jquery'
    ], function () {
        jQuery('.product-image-wrapper').hover(function() {
            jQuery(this).children('.hover_image').css('display', 'block');
            jQuery(this).children('.hover_image').stop(true).fadeTo(200,1);
        }, function() {
            jQuery(this).children('.hover_image').fadeOut();
            jQuery(this).children('.hover_image').css('display', 'none');
        });
    });
</script>

<?php if (!$_productCollection->count()): ?>
    <div class="message info empty"><div><?= /* @escapeNotVerified */ __('We can\'t find products matching the selection.') ?></div></div>
<?php else: ?>
    <?= $block->getToolbarHtml() ?>
    <?= $block->getAdditionalHtml() ?>
    <?php
    if ($block->getMode() == 'grid') {
        $viewMode = 'grid';
        $image = 'category_page_grid';
        $showDescription = false;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
    } else {
        $viewMode = 'list';
        $image = 'category_page_list';
        $showDescription = true;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::FULL_VIEW;
    }
    /**
     * Position for actions regarding image size changing in vde if needed
     */
    $pos = $block->getPositioned();
    ?>
    <div class="products wrapper <?= /* @escapeNotVerified */ $viewMode ?> products-<?= /* @escapeNotVerified */ $viewMode ?>">
        <?php $iterator = 1; ?>
        <ol class="products list items product-items">
            <?php /** @var $_product \Magento\Catalog\Model\Product */ ?>
            <?php foreach ($_productCollection as $_product): ?>
                <?= /* @escapeNotVerified */ ($iterator++ == 1) ? '<li class="item product product-item mw-50">' : '</li><li class="item product product-item mw-50">' ?>
                <div class="product-item-info" data-container="product-grid">
                    <div data-role="add-to-links" class="actions-secondary"<?= strpos($pos, $viewMode . '-secondary') ? $position : '' ?>>
                        <?php if ($addToBlock = $block->getChildBlock('addto')): ?>
                            <?= $addToBlock->setProduct($_product)->getChildHtml() ?>
                        <?php endif; ?>
                    </div>

                    <?php if(date('Y-m-d H:i:s') >= $_product->getData('news_from_date') && date('Y-m-d H:i:s') <= $_product->getData('news_to_date')) :?>
                        <span class="tag-new">Novo</span>
                    <?php endif ;?>

                    <?php
                    $productImage = $block->getImage($_product, $image);
                    if ($pos != null) {
                        $position = ' style="left:' . $productImage->getWidth() . 'px;'
                            . 'top:' . $productImage->getHeight() . 'px;"';
                    }
                    ?>
                    <?php // Product Image ?>
                    <a href="<?= /* @escapeNotVerified */ $_product->getProductUrl() ?>" class="product photo product-item-photo text-center" tabindex="-1">
                        <?php $productImageBlock = $block->getImage($_product, $image); ?>
                        <?php echo $this->getLayout()
                            ->createBlock('Itatiaia\ProductTag\Block\Product\Image')
                            ->setProduct($_product)
                            ->setTemplate('Itatiaia_ProductTag::product/tag.phtml')->toHtml() ?>
                        <?php echo $productImageBlock->toHtml() ?>
                    </a>
                    <div class="product details product-item-details">
                        <?php
                        $_productNameStripped = $block->stripTags($_product->getName(), null, true);
                        ?>
                        <h2 class="product name product-item-name">
                            <a class="product-item-link"
                               href="<?= /* @escapeNotVerified */ $_product->getProductUrl() ?>">
                                <?= /* @escapeNotVerified */ $_helper->productAttribute($_product, $_product->getName(), 'name') ?>
                            </a>
                        </h2>

                        <?= /* @escapeNotVerified */ $block->getProductPrice($_product) ?>

                        <?php /* $block->getProductDetailsHtml($_product) */ ?>

                        <div class="preco-parcelado">
                            <?php
                            echo $this->getLayout()
                                ->createBlock('\DigitalHub\AdditionalPrices\Block\Product\Additional')
                                ->setTemplate('DigitalHub_AdditionalPrices::product/additional_prices.phtml')
                                ->setProduct($_product)
                                ->toHtml();
                            ?>
                        </div>

                        <div class="product-item-inner">
                            <div class="product actions product-item-actions"<?= strpos($pos, $viewMode . '-actions') ? $position : '' ?>>
                                <?php if ($_product->getShortDescription()): ?>
                                    <div class="desc-bbb">
                                        <?php /* @escapeNotVerified */ echo $_helper->productAttribute($_product, $_product->getShortDescription(), 'short_description'); ?>
                                    </div>
                                <?php endif; ?>
                                <div class="actions-primary"<?= strpos($pos, $viewMode . '-primary') ? $position : '' ?>>
                                    <?php if ($_product->isAvailable()): ?>
                                        <a href="<?php echo $_product->getProductUrl() ?>" class="action tocart primary">
                                            <span><?php echo __('Comprar') ?></span>
                                        </a>
                                    <?php else: ?>
                                        <?php if ($_product->isAvailable()): ?>
                                            <div class="stock available"><span><?= /* @escapeNotVerified */ __('In stock') ?></span></div>
                                        <?php else: ?>
                                            <div class="stock unavailable"><span><?= /* @escapeNotVerified */ __('Item indisponível no momento') ?></span></div>
                                        <?php endif; ?>
                                    <?php endif; ?>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
                <?= ($iterator == count($_productCollection)+1) ? '</li>' : '' ?>
            <?php endforeach; ?>
        </ol>
    </div>
    <div class="bottom-toolbar">
        <?= $block->getToolbarHtml() ?>
    </div>
    <?php if (!$block->isRedirectToCartEnabled()) : ?>
        <script type="text/x-magento-init">
    {
      "[data-role=tocart-form], .form.map.checkout": {
        "catalogAddToCart": {
          "product_sku": "<?= /* @NoEscape */ $_product->getSku() ?>"
        }
      }
    }
    </script>
    <?php endif; ?>
<?php endif; ?>

<?php if(count($_productCollection)): ?>
    <?php
    $groupedHelper = $this->helper('\Itatiaia\GroupedCatalogRule\Helper\Data');
    $productsListData = [];
    $position = 1;
    foreach($_productCollection as $_product){
        $productData = [
            'id' => $_product->getId(),
            'name' => $_product->getName(),
            'price' => $_product->getTypeId() == 'simple' ? $_product->getFinalPrice() : $groupedHelper->getFinalPrice($_product),
            'brand' => $_product->getManufacturer() ? $_product->getManufacturer() : 'Itatiaia',
            'list' => 'Categoria',
            'position' => $position
        ];
        $productsListData[] = $productData;
        $position++;
    }
    ?>
    <script>
        if(!window.dataLayer) window.dataLayer = []
        window.dataLayer.push({
            "ecommerce": {
                "currencyCode": "BRL",
                "impressions": <?php echo json_encode($productsListData); ?>
            }
        });
    </script>
<?php endif; ?>
<style>
    .mw-50 {
        min-width: 50% !important;
    }
    .text-center {
        text-align: center !important;
    }
    .product-item-info {
        height: unset !important;
    }
    .product-item-name {
        height: 36px !important;
    }
    .desc-bbb{
        min-height: 110px;
        text-align: justify !important;
				display: none;
    }
    .product-item:hover .product-item-info .product-item-details .product-item-actions {
        position: relative !important;
        width: auto !important;
    }
</style>
