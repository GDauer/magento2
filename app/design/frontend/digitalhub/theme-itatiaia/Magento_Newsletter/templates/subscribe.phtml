/** @var \Magento\Newsletter\Block\Subscribe $block */

?>
<div class="block newsletter">
  <form class="form subscribe" novalidate action="<?= $block->escapeUrl($block->getFormActionUrl()) ?>" method="post" data-mage-init='{"validation": {"errorClass": "mage-error"}}' id="newsletter-validate-detail">
    <div class="field newsletter">
      <div class="control">
        <input name="email" type="email" id="newsletter" placeholder="<?= $block->escapeHtmlAttr(__('Enter your email address')) ?>" data-validate="{required:true, 'validate-email':true}"/>
      </div>
      <button class="action subscribe primary" title="<?= $block->escapeHtmlAttr(__('Subscribe')) ?>" type="submit" title="<?= $block->escapeHtml(__('Subscribe')) ?>"></button>
    </div>
  </form>
</div>
<script>
    require([
        'jquery',
        'Magento_Ui/js/modal/modal'
    ], function($){
        jQuery('#newsletter-validate-detail').submit(function(){
            var email = jQuery(this).find('input[name=email]').val();
            var filter = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;

            if(filter.test(email)){
                jQuery.ajax({
                    url: '<?= $block->escapeUrl($block->getUrl('itatiaia_custom/newsletter/subscribe')) ?>',
                    method: 'POST',
                    data: {email: email},
                    success: function(result){
                        if(result.success){
                            var content = document.createElement('div')
                            $(content).html('<h4>Obrigado por se cadastrar!</h4>');
                            $(content).modal({
                                modalClass: 'popup-alert-news',
                                buttons: [],
                                width: '20%'
                            });
                            $(content).modal('openModal');
                        } else {
                            var content = document.createElement('div')
                            if(result.registered) {
                                $(content).html('<h4>Já existe um usuário cadastrado com esse e-mail.</h4>');
                            } else {
                                $(content).html('<h4>Ocorreu um erro ao tentar realizar o cadastro. Por favor, tente novamente mais tarde.</h4>');
                            }
                            $(content).modal({
                                modalClass: 'popup-alert-news',
                                buttons: [],
                                width: '20%'
                            });
                            $(content).modal('openModal');
                        }
                    }
                })
            }

            return false
        })
    })
</script>
