<?php
$product = $block->getProduct();
$oldPrice = 0;
$finalPrice = 0;
$discount = 0;
$associatedProducts = $product->getTypeInstance(true)->getAssociatedProducts($product);
foreach ($associatedProducts as $item) {
    $childProduct = \Magento\Framework\App\ObjectManager::getInstance()->get('\Magento\Catalog\Model\Product')->load($item->getId());
    $oldPrice = $oldPrice + (float)$childProduct->getPrice();
    $finalPrice = $finalPrice + (float)$childProduct->getFinalPrice();
}
$discount = (int)(($oldPrice * 100) / $finalPrice) - 100;
?>
<div class="wrp-grouped-details">
  <h1 class="product-name"><?= $product->getName(); ?></h1>
</div>

<div class="price-box price-final_price">
    <div class="wrp-oldprice">
        <span class="old-price">
            <span class="price-container price-final_price tax weee">
                <span id="old-price-<?= $product->getId() ?>" class="price-wrapper">
                    <span class="price old-price-grouped"><?= $oldPrice ?></span>
                </span>
            </span>
        </span>
        <div class="wrp-desc">
            <span class="tag-desc discount-grouped"><?= $discount ?>%</span>
        </div>
    </div>
    <div class="clear"></div>
    <span class="special-price">
        <span class="price-container price-final_price tax weee" itemprop="offers" itemscope="" itemtype="http://schema.org/Offer">
            <span id="product-price-<?= $product->getId() ?>" class="price-wrapper">
                <span class="price final-price-grouped"><?= $finalPrice ?></span>
            </span>
            <meta itemprop="price" content="<?= number_format($finalPrice, 2) ?>">
            <meta itemprop="priceCurrency" content="BRL">
        </span>
    </span>
</div>
