 *
 * @var $block \Smile\ElasticsuiteCatalog\Block\Navigation
 */
?>

<?php
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $category = $objectManager->get('Magento\Framework\Registry')->registry('current_category');
?>

<?php if ($block->canShowBlock()) : ?>
    <?php $activeFilters = $block->getActiveFilters(); ?>
    <div class="block filter" id="layered-filter-block" data-mage-init='{"collapsible":{"openedState": "active", "collapsible": true, "active": false, "collateral": { "openedState": "filter-active", "element": "body" } }}'>
        <?php $filtered = count($block->getLayer()->getState()->getFilters()) ?>

        <div class="block-title filter-title" data-count="<?= /* @escapeNotVerified */ $filtered ?>">
            <?php if ($this->getRequest()->getFullActionName() == 'catalog_category_view'): ?>
                <strong data-role="title"><?php echo $category->getName(); ?></strong>
            <?php endif; ?>
            <a class="show-filters" href="javascript:void(0);">
                Filtro
                <span class="icon-filters"></span>
            </a>
        </div>


        <div class="block-content filter-content">

            <?php $wrapOptions = false; ?>
            <?php foreach ($block->getFilters() as $filter) : ?>
                <?php if ($filter->getItemsCount()) : ?>
                    <?php if (!$wrapOptions) : ?>
                      <div class="hdr-filter">
                        <strong role="heading" aria-level="2" class="block-subtitle filter-subtitle"><?= /* @escapeNotVerified */ __('Shopping Options') ?></strong>
                        <div class="cls-filters">
                          <a href="javascript:void(0);" class="cls-btn"></a>
                        </div>
                      </div>
                        <div class="filter-options" id="narrow-by-list" data-role="content" data-mage-init='{"accordion":{"openedState": "active", "collapsible": true, "active": <?php  /* @noEscape */ echo $activeFilters; ?>, "multipleCollapsible": <?= /* @noEscape */ $block->isInline() ? "false" : "true"; ?>}}'>
                            <span class="label-fltr">Filtrar por:</span>
                            <?php $wrapOptions = true;?>
                    <?php endif; ?>
                    <div data-role="collapsible" class="filter-options-item">
                        <div data-role="title" class="filter-options-title"><?= /* @escapeNotVerified */ __($filter->getName()) ?></div>
                        <div data-role="content" class="filter-options-content"><?= /* @escapeNotVerified */ $block->getChildBlock('renderer')->render($filter) ?></div>
                    </div>
                <?php endif; ?>
            <?php endforeach; ?>
            <?php if ($wrapOptions) : ?>
                </div>
            <?php else : ?>
                <script>
                    require([
                        'jquery'
                    ], function ($) {
                        $('#layered-filter-block').addClass('filter-no-options');
                    });
                </script>
            <?php endif; ?>
            <?php echo $block->getChildHtml('state') ?>

            <?php if ($block->getLayer()->getState()->getFilters()) : ?>
                <div class="block-actions filter-actions">
                    <a href="<?php /* @escapeNotVerified */ echo $block->getClearUrl() ?>" class="action clear filter-clear">
                        <span><?php /* @escapeNotVerified */ echo __('Remover todos os filtros') ?></span>
                    </a>
                </div>
            <?php endif; ?>

            <form action="<?php echo $block->getClearUrl() ?>" id="form-filter-multiple">
                <button type="submit" class="apply-fltr"> Aplicar Filtros</button>
            </form>
            <script type="text/javascript">
                require(['jquery'], function($){
                    var form = $('#form-filter-multiple')
                    form.submit(function(){
                        var params = getParams(document.location.href)
                        var from = window._priceFilterFrom;
                        var to = window._priceFilterTo;
                        if(form.find('input[name=price]').length){
                            form.find('input[name=price]').val(from + '-' + to);
                        } else {
                            form.append('<input type="hidden" name="price" value="'+from+'-'+to+'" />');
                        }
                        return true;
                    });

                    var getParams = function (url) {
                    	var params = {};
                    	var parser = document.createElement('a');
                    	parser.href = url;
                    	var query = parser.search.substring(1);
                    	var vars = query.split('&');
                    	for (var i = 0; i < vars.length; i++) {
                    		var pair = vars[i].split('=');
                    		params[pair[0]] = decodeURIComponent(pair[1]);
                    	}
                    	return params;
                    };

                    var params = getParams(document.location.href);

                    for(var key in params){
                        if(!key || !params[key]) continue;

                        var filterVar = decodeURIComponent(key).replace(/\[.*\]/, '');
                        var filterValue = params[key];
                        if(filterVar == 'price'){
                            form.append('<input type="hidden" name="price" value="'+filterValue+'" />');
                        } else {
                            form.append('<input type="hidden" name="'+filterVar+'" value="'+filterValue+'" />');
                        }
                    }
                })
            </script>

        </div>
    </div>
<?php endif; ?>
