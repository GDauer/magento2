<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
  <head>
    <script src="Magento_Checkout::js/view/active-steps.js" />
    <script src="DigitalHub_CustomerAttributes::js/checkout/shipping-address.js" />
  </head>
  <body>
      <referenceContainer name="after.body.start">
        <block name="adyen_external_js" template="Adyen_Payment::external_js.phtml" />
      </referenceContainer>
      
      <referenceBlock name="page.main.title">
          <action method="setPageTitle">
              <argument translate="true" name="page_title" xsi:type="string">Finalizar pedido</argument>
          </action>
      </referenceBlock>
      <referenceBlock name="checkout.root">
          <arguments>
              <argument name="jsLayout" xsi:type="array">
                  <item name="components" xsi:type="array">
                      <item name="checkout" xsi:type="array">
                          <item name="children" xsi:type="array">
                              <item name="steps" xsi:type="array">
                                  <item name="children" xsi:type="array">
                                      <item name="billing-step" xsi:type="array">
                                          <item name="children" xsi:type="array">
                                              <item name="payment" xsi:type="array">
                                                  <item name="children" xsi:type="array">
                                                      <item name="additional-payment-validators" xsi:type="array">
                                                          <item name="children" xsi:type="array">
                                                              <item name="cpfValidation" xsi:type="array">
                                                                  <item name="component" xsi:type="string">Itatiaia_Custom/js/view/cpf-validation</item>
                                                              </item>
                                                          </item>
                                                      </item>
                                                  </item>
                                              </item>
                                          </item>
                                      </item>
                                  </item>
                              </item>
                          </item>
                      </item>
                  </item>
              </argument>
          </arguments>
      </referenceBlock>
  </body>
</page>
