<?xml version="1.0"?>
<indices xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Smile_ElasticsuiteCore:etc/elasticsuite_indices.xsd">

    <index identifier="catalog_product" defaultSearchType="product">
        <type name="product" idFieldName="entity_id">
            <datasources>
                <datasource name="extra_sorting_fields">DigitalHub\SortingOptions\Model\Product\Indexer\Fulltext\Datasource\SortingData</datasource>
            </datasources>
            <mapping>
                <field name="price.discount_percentage_amount" type="double" nestedPath="price" />
            </mapping>
        </type>
    </index>
</indices>
