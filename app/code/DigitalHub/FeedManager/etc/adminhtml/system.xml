<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../Config/etc/system_file.xsd">
    <system>
        <section id="digitalhub_feedmanager" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Feed XML</label>
            <class>separator-top</class>
            <tab>catalog</tab>
            <resource>Magento_Catalog::config_catalog</resource>
            <group id="cron" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Crons</label>
                <field id="cron_frequency" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Frequência de atualização</label>
                    <comment>Formato: * * * * *</comment>
                    <backend_model>DigitalHub\FeedManager\Model\Config\Source\CronConfig</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
