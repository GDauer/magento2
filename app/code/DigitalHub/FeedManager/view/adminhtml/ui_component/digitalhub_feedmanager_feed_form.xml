<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalhub_feedmanager_feed_form.digitalhub_feedmanager_feed_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Informações gerais</item>
    </argument>
    <settings>
        <buttons>
			<button name="back" class="Magento\Customer\Block\Adminhtml\Edit\BackButton"/>
			<button name="save" class="DigitalHub\FeedManager\Block\Adminhtml\Feed\Edit\SaveButton" />
			<button name="delete" class="DigitalHub\FeedManager\Block\Adminhtml\Feed\Edit\DeleteButton" />
        </buttons>
        <layout>
            <navContainerName>left</navContainerName>
            <type>tabs</type>
        </layout>
		<namespace>digitalhub_feedmanager_feed_form</namespace>
        <dataScope>feed</dataScope>
        <deps>
            <dep>digitalhub_feedmanager_feed_form.digitalhub_feedmanager_feed_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="digitalhub_feedmanager_feed_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="DigitalHub\FeedManager\Model\Feed\DataProvider" name="digitalhub_feedmanager_feed_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

	<fieldset name="feed"> <!-- usar mesmo nome do source do DataProvider -->
		<argument name="data" xsi:type="array">
			<item name="config" xsi:type="array">
				<item name="label" xsi:type="string">Informações gerais</item>
			</item>
		</argument>

		<field name="name">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Nome do feed</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">feed</item>
					<item name="sortOrder" xsi:type="number">10</item>
					<item name="dataScope" xsi:type="string">name</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>

		<field name="filename">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Nome do arquivo</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">feed</item>
					<item name="sortOrder" xsi:type="number">20</item>
					<item name="dataScope" xsi:type="string">filename</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>

		<field name="store_id">
		    <argument name="data" xsi:type="array">
		        <item name="options" xsi:type="object">Magento\Store\Ui\Component\Listing\Column\Store\Options</item>
		        <item name="config" xsi:type="array">
		            <item name="dataType" xsi:type="string">int</item>
		            <item name="label" xsi:type="string" translate="true">Store View</item>
		            <item name="formElement" xsi:type="string">select</item>
		            <item name="source" xsi:type="string">feed</item>
		            <item name="dataScope" xsi:type="string">store_id</item>
		            <item name="default" xsi:type="string">0</item>
		            <item name="validation" xsi:type="array">
		                <item name="required-entry" xsi:type="boolean">true</item>
		            </item>
		        </item>
		    </argument>
		</field>

		<field name="template_id">
		    <argument name="data" xsi:type="array">
		        <item name="options" xsi:type="object">DigitalHub\FeedManager\Model\Config\Source\Template</item>
		        <item name="config" xsi:type="array">
		            <item name="dataType" xsi:type="string">int</item>
		            <item name="label" xsi:type="string" translate="false">Template</item>
		            <item name="formElement" xsi:type="string">select</item>
		            <item name="source" xsi:type="string">feed</item>
		            <item name="dataScope" xsi:type="string">template_id</item>
		            <item name="default" xsi:type="string">0</item>
		            <item name="validation" xsi:type="array">
		                <item name="required-entry" xsi:type="boolean">true</item>
		            </item>
		        </item>
		    </argument>
		</field>

		<field name="active" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feed</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
                </item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Ativo</label>
                <visible>true</visible>
                <dataScope>active</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="number">1</item>
                                <item name="label" xsi:type="string" translate="true">Sim</item>
                            </option>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="number">0</item>
                                <item name="label" xsi:type="string" translate="true">Não</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
