<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalhub_menumanager_menu_form.digitalhub_menumanager_menu_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Informações gerais</item>
    </argument>
    <settings>
        <buttons>
			<button name="back" class="Magento\Customer\Block\Adminhtml\Edit\BackButton"/>
			<button name="save" class="DigitalHub\MenuManager\Block\Adminhtml\Menu\Edit\SaveButton" />
			<button name="delete" class="DigitalHub\MenuManager\Block\Adminhtml\Menu\Edit\DeleteButton" />

            <!-- <button name="save_and_continue" class="Magento\Customer\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="reset" class="Magento\Customer\Block\Adminhtml\Edit\ResetButton"/>
            <button name="order" class="Magento\Customer\Block\Adminhtml\Edit\OrderButton"/>
            <button name="resetPassword" class="Magento\Customer\Block\Adminhtml\Edit\ResetPasswordButton"/>
            <button name="unlock" class="Magento\Customer\Block\Adminhtml\Edit\UnlockButton"/>
            <button name="invalidateToken" class="Magento\Customer\Block\Adminhtml\Edit\InvalidateTokenButton"/>
            <button name="delete" class="Magento\Customer\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="back" class="Magento\Customer\Block\Adminhtml\Edit\BackButton"/> -->
        </buttons>
        <layout>
            <navContainerName>left</navContainerName>
            <type>tabs</type>
        </layout>
		<namespace>digitalhub_menumanager_menu_form</namespace>
        <dataScope>menu</dataScope>
        <deps>
            <dep>digitalhub_menumanager_menu_form.digitalhub_menumanager_menu_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="digitalhub_menumanager_menu_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="DigitalHub\MenuManager\Model\Menu\DataProvider" name="digitalhub_menumanager_menu_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

	<fieldset name="menu"> <!-- usar mesmo nome do source do DataProvider -->
		<argument name="data" xsi:type="array">
			<item name="config" xsi:type="array">
				<item name="label" xsi:type="string">Informações gerais</item>
			</item>
		</argument>
		<field name="name">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Nome do menu</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">menu</item>
					<item name="sortOrder" xsi:type="number">10</item>
					<item name="dataScope" xsi:type="string">name</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>

		<field name="identifier">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Identificador do menu</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">menu</item>
					<item name="sortOrder" xsi:type="number">20</item>
					<item name="dataScope" xsi:type="string">identifier</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>

		<field name="json_data">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="formElement" xsi:type="string">hidden</item>
					<item name="source" xsi:type="string">menu</item>
					<item name="sortOrder" xsi:type="number">10</item>
					<item name="dataScope" xsi:type="string">json_data</item>
				</item>
			</argument>
		</field>

		<!-- <field name="type" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">menu</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Tipo do menu</label>
                <visible>true</visible>
                <dataScope>type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="horizontal" xsi:type="array">
                                <item name="value" xsi:type="string">horizontal</item>
                                <item name="label" xsi:type="string" translate="true">Horizontal</item>
                            </option>
                            <option name="vertical" xsi:type="array">
                                <item name="value" xsi:type="string">vertical</item>
                                <item name="label" xsi:type="string" translate="true">Vertical</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field> -->

		<field name="active" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">menu</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
                </item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Ativo</label>
                <visible>true</visible>
                <dataScope>active</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="number">1</item>
                                <item name="label" xsi:type="string" translate="true">Sim</item>
                            </option>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="number">0</item>
                                <item name="label" xsi:type="string" translate="true">Não</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
	</fieldset>

	<fieldset name="itens">
		<argument name="data" xsi:type="array">
			<item name="config" xsi:type="array">
				<item name="label" xsi:type="string">Estrutura do menu</item>
			</item>
		</argument>
		<container name="menu_itens_container">
			<htmlContent name="menu_editor">
				<argument name="block" xsi:type="object">\Magento\Framework\View\Element\Text</argument>
				<argument name="data" xsi:type="array">
					<item name="config" xsi:type="array">
						<item name="component" xsi:type="string">DigitalHub_MenuManager/js/view/menu/editor</item>
					</item>
				</argument>
			</htmlContent>
		</container>
	</fieldset>
</form>
