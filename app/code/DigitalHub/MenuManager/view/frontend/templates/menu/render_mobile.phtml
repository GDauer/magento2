<?php if($this->getMenu()->getActive()): ?>

    <?php $jsonData = $this->getJsonData() ?>

    <div class="container-menumanager-menu-mobile">
        <nav id="menumanager-menu-<?php echo $this->getMenu()->getId() ?>" class="navigation" data-action="navigation">
            <ul data-mage-init='{"menu":{"responsive":true, "expanded":true, "position":{"my":"left top","at":"left bottom"}}}' class="ui-menu ui-widget ui-widget-content ui-corner-all" role="menu" tabindex="0">
                <?php foreach($jsonData as $item): ?>
                    <?php $item = $this->parseItemData($item) ?>

                    <li rel="<?php echo $item->getId() ?>" class="level0 level-top ui-menu-item <?php if($item->getHasChildren()) echo "parent"; ?>" role="presentation">
                        <a href="<?php echo $item->getOptions()->getUrl() ?>" class="ui-corner-all level-top" tabindex="-1" role="menuitem">
                            <span><?php echo $item->getText() ?></span>
                        </a>

                        <?php if($item->getHasChildren()): ?>

                            <?php if($item->getOptions()->getType() == 'category' && $item->getOptions()->getUseSubcategoriesTree()): ?>

                                <ul class="level0 submenu ui-menu ui-widget ui-widget-content ui-corner-all" role="menu" aria-hidden="true" aria-expanded="false">
                                    <?php foreach($item->getCategory()->getChildrenCategories() as $_category): ?>
                                        <li class="level1 ui-menu-item <?php if(count($_category->getChildrenCategories())) echo "parent"; ?>" role="presentation">
                                            <a href="<?php echo $_category->getUrl() ?>">
                                                <span><?php echo $_category->getName() ?></span>
                                            </a>

                                            <!-- Level 3 -->
                                            <?php if(count($_category->getChildrenCategories())): ?>
                                            <ul class="level1 submenu ui-menu ui-widget ui-widget-content ui-corner-all" role="menu" aria-hidden="true" aria-expanded="false">
                                                <?php foreach($_category->getChildrenCategories() as $_subCategory): ?>
                                                    <li class="level2 ui-menu-item" role="presentation">
                                                        <a href="<?php echo $_subCategory->getUrl() ?>">
                                                            <span><?php echo $_subCategory->getName() ?></span>
                                                        </a>
                                                    </li>
                                                <?php endforeach; ?>
                                            </ul>
                                            <?php endif; ?>

                                        </li>
                                    <?php endforeach; ?>
                                </ul>

                            <?php else: ?>
                                <!-- Level 2 -->
                                <ul class="level0 submenu ui-menu ui-widget ui-widget-content ui-corner-all" role="menu" aria-hidden="true" aria-expanded="false">
                                    <?php foreach($item->getChildren() as $subitem): ?>
                                        <?php $subitem = $this->parseItemData($subitem) ?>
                                        <li class="level1 ui-menu-item <?php if($subitem->getHasChildren()) echo "parent"; ?>" role="presentation">
                                            <a href="<?php echo $subitem->getOptions()->getUrl() ?>" class="ui-corner-all" tabindex="-1" role="menuitem">
                                                <span><?php echo $subitem->getText() ?></span>
                                            </a>

                                            <!-- Level 3 -->
                                            <?php if(count($subitem->getChildren())): ?>
                                            <ul class="level1 submenu ui-menu ui-widget ui-widget-content ui-corner-all" role="menu" aria-hidden="true" aria-expanded="false">
                                                <?php foreach($subitem->getChildren() as $sub_subitem): ?>
                                                    <?php $sub_subitem = $this->parseItemData($sub_subitem) ?>
                                                    <li class="level2 ui-menu-item" role="presentation">
                                                        <a href="<?php echo $sub_subitem->getOptions()->getUrl() ?>">
                                                            <span><?php echo $sub_subitem->getText() ?></span>
                                                        </a>
                                                    </li>
                                                <?php endforeach; ?>
                                            </ul>
                                            <?php endif; ?>

                                        </li>
                                    <?php endforeach; ?>
                                </ul>
                            <?php endif; ?>

                        <?php endif; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </nav>
    </div>

