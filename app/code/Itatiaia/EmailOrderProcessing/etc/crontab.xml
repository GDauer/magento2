<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="itatiaia_email_order_processing" instance="Itatiaia\EmailOrderProcessing\Cron\SendEmail" method="execute">
            <schedule>0 */1 * * *</schedule> <!-- a cada 1 hora verificar se existem pedidos para envio -->
        </job>
    </group>
</config>
