<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
  <group id="custom_checkout_ticket">
    <field id="order_status_approved" translate="label" type="select" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="0">
