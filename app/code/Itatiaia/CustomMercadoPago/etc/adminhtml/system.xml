<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
  <system>
    <section id="payment">
      <group id="mercadopago_configurations">
        <label>Habilitar Mapeamento</label>
        <field id="custom_responses_active" translate="label" type="select" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="0">
          <label>Ativo</label>
          <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
        </field>
        <field id="custom_responses" translate="label" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="0">
          <label>Mapeamento de Respostas</label>
          <frontend_model>Itatiaia\CustomMercadoPago\Model\System\Config\Source\Order\Response</frontend_model>
          <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
          <depends>
            <field id="custom_responses_active">1</field>
          </depends>
        </field>
        <include path="Itatiaia_CustomMercadoPago::system/custom_checkout.xml"/>
        <include path="Itatiaia_CustomMercadoPago::system/custom_checkout_ticket.xml"/>
        <include path="Itatiaia_CustomMercadoPago::system/order_management.xml"/>
      </group>
    </section>
  </system>
</config>