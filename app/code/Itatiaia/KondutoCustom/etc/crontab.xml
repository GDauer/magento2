<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="konduto">
        <job instance="Konduto\Antifraud\Cron\CreateOrders" method="execute" name="konduto_antifraud_create_orders">
            <config_path>* * * * *</config_path>
        </job>
    </group>
    <group id="konduto">
        <job name="konduto_antifraud_update_order_status" instance="Itatiaia\KondutoCustom\Cron\UpdateOrderStatus" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>