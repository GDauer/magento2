<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="cms">
            <group id="external_images" translate="label" type="text" sortOrder="100" showInDefault="1">
                <label>Imagens Externas</label>
                <field id="enabled" translate="label" type="select" sortOrder="1" showInDefault="1">
                    <label>Habilitar validação de imagens externas</label>
                    <source_model>Magento\Config\Model\Config\Source\YesNo</source_model>
                </field>
                <field id="recipients" translate="label" type="text" sortOrder="1" showInDefault="1">
                    <label>Enviar alerta para</label>
                    <comment>Múltiplos endereços separados por vírgula</comment>
                </field>
            </group>
        </section>
    </system>
</config>
