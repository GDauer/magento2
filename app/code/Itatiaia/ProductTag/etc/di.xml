<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../lib/internal/Magento/Framework/ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="itatiaia_tag_tag_listing_data_source" xsi:type="string">Itatiaia\ProductTag\Model\Resource\Tag\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Itatiaia\ProductTag\Model\Resource\Tag\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">itatiaia_product_tag</argument>
            <argument name="resourceModel" xsi:type="string">Itatiaia\ProductTag\Model\Resource\Tag</argument>
        </arguments>
    </virtualType>
    <type name="Itatiaia\ProductTag\Model\ImageUploader">
        <arguments>
            <!-- Temporary file stored in pub/media/tag/tmp/icon -->
            <argument name="baseTmpPath" xsi:type="string">tag/tmp/icon</argument>
            <argument name="basePath" xsi:type="string">tag/icon</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </type>
</config>