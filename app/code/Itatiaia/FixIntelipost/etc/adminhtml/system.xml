<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="intelipost_push">
            <group id="holidays_table" translate="label" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Relação de dias Úteis</label>
                <field id="business_days" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Dias Úteis</label>
                    <frontend_model>Itatiaia\FixIntelipost\Block\Adminhtml\Form\Field\DateOptions</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
                <field id="business_days_disabled" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Datas Desabilitados</label>
                    <frontend_model>Itatiaia\FixIntelipost\Block\Adminhtml\Form\Field\DisabledDateOptions</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
            </group>
        </section>
        <section id="carriers">
            <group id="itatiaia_fixintelipost" translate="label" type="text" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Configuração customizadas Itatiaia / Intelipost</label>
                <field id="hide_carrier_title" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Ocultar nome da transportadora</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="zipcode_warehouse_aco" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>CEP origem de CD para material aço</label>
                </field>
                <field id="zipcode_block_rates" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Faixas de CEP para bloqueio de entregas</label>
                    <comment>Para múltiplas faixas, separar valores com '-' e ';'. Exemplo: 80000000-90000000; 01000000-10000000;</comment>
                </field>
                <field id="zipcode_cd_eletro" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>CEP de origem de CD padrão para Eletro</label>
                </field>
                <field id="zipcode_range_cd_eletro" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Faixas de CEP para uso de CD de Eletro</label>
                </field>
                <field id="attribute_set_id_eletro" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>ID do grupo de atributos de Eletro</label>
                </field>
            </group>
        </section>
    </system>
</config>
