{
    "name": "magento/project-enterprise-edition",
    "description": "eCommerce Platform for Growth (Enterprise Edition)",
    "type": "project",
    "version": "2.3.0",
    "license": [
        "proprietary"
    ],
    "require": {
        "adyen/module-payment": "4.2.0",
        "composer/composer": "@alpha",
        "cweagans/composer-patches": "^1.6",
        "digitalhub/additional-prices": "dev-master",
        "digitalhub/customer-attributes": "dev-master",
        "digitalhub/estimate-shipping": "dev-master",
        "digitalhub/module-cookie": "dev-master",
        "digitalhub/theme-base": "dev-master",
        "digitalhub/theme-base-mobile": "dev-fix/itatiaia",
        "flancer32/mage2_ext_minify": "^0.1.2",
        "intelipost/magento2-basic": "^1.1",
        "intelipost/magento2-push": "^1.1",
        "intelipost/magento2-quote": "^1.3",
        "intelipost/magento2-tracking": "^1.2",
        "konduto/magento2": "^1.0",
        "magento/ece-tools": "^2002.0",
        "magento/product-enterprise-edition": "2.3.0",
        "magepal/magento2-gmailsmtpapp": "^2.5",
        "magepal/magento2-googletagmanager": "2.2.9",
        "mercadopago/magento2-plugin": "3.3.1",
        "mundipagg/mundipagg-magento2-module": "^1.8",
        "mustache/mustache": "^2.12",
        "platformsh/magento2-configuration": "2.2.*",
        "pmclain/magento2-successtest": "^2.0",
        "scandiweb/module-core": "~0.1.2",
        "scandiweb/module-magiczoom": "1.1.4",
        "smile/elasticsuite": "~2.8.0",
        "swissup/firecheckout": "^1.18",
        "swissup/rtl": "^1.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "~2.10.1",
        "lusitanian/oauth": "~0.8.10",
        "magento-ecg/coding-standard": "3.*",
        "pdepend/pdepend": "2.5.2",
        "phpmd/phpmd": "@stable",
        "phpunit/phpunit": "~6.2.0",
        "sebastian/phpcpd": "~3.0.0",
        "squizlabs/php_codesniffer": "3.2.2"
    },
    "autoload": {
        "psr-4": {
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/",
            "Magento\\": "app/code/Magento/",
            "Zend\\Mvc\\Controller\\": "setup/src/Zend/Mvc/Controller/"
        },
        "psr-0": {
            "": [
                "app/code/"
            ]
        },
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\ToolkitFramework\\": "dev/tools/performance-toolkit/framework/Magento/ToolkitFramework/"
        }
    },
    "minimum-stability": "stable",
    "repositories": {
        "0": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        "1": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/themes/base.git"
        },
        "2": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/themes/base-mobile.git"
        },
        "3": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/additional-prices.git"
        },
        "4": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/menu-manager.git"
        },
        "5": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/estimate-shipping.git"
        },
        "6": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/customer-attributes.git"
        },
        "7": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/language-pt_br.git"
        },
        "8": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/banners.git"
        },
        "9": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/feed-manager.git"
        },
        "10": {
            "type": "vcs",
            "url": "https://gitlab.com/digitalhub/m2/modules/module-cookie.git"
        },
        "scandiweb-module-core": {
            "type": "git",
            "url": "https://github.com/scandiwebcom/Scandiweb-Assets-Core.git"
        },
        "module-magiczoom": {
            "type": "git",
            "url": "git@github.com:scandiwebcom/Magic-Zoom-for-Magento-2-by-Scandiweb.git"
        },
        "swissuplabs": {
            "type": "composer",
            "url": "https://ci.swissuplabs.com/api/packages.json"
        }
    },
    "extra": {
        "magento-force": "override"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "prefer-stable": true
}
