{
    "name": "magento/project-enterprise-edition",
    "description": "eCommerce Platform for Growth (Enterprise Edition)",
    "type": "project",
    "version": "2.3.6",
    "license": "OSL-3.0",
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "repositories": {
        "repo": {
            "type": "composer",
            "url": "https://repo.magento.com"
        },
        "swissuplabs": {
            "type": "composer",
            "url": "https://ci.swissuplabs.com/api/packages.json"
        },
        "scandiweb-module-core": {
            "type": "git",
            "url": "https://github.com/scandiwebcom/Scandiweb-Assets-Core.git"
        },
        "module-magiczoom": {
            "type": "git",
            "url": "git@github.com:scandiwebcom/Magic-Zoom-for-Magento-2-by-Scandiweb.git"
        }
    },
    "require": {
        "cweagans/composer-patches": "^1.6",
        "flancer32/mage2_ext_minify": "^0.1.2",
        "intelipost/magento2-basic": "~1.2.0",
        "intelipost/magento2-push": "~1.2.0",
        "intelipost/magento2-quote": "~1.4.0",
        "intelipost/magento2-tracking": "~1.3.0",
        "konduto/magento2": "^1.0",
        "magento/magento-cloud-metapackage": ">=2.3.6 <2.3.7",
        "magepal/magento2-gmailsmtpapp": "^2.5",
        "magepal/magento2-googletagmanager": "2.2.9",
        "mercadopago/magento2-plugin": "3.6.0",
        "mustache/mustache": "^2.12",
        "pmclain/magento2-successtest": "^2.0",
        "scandiweb/module-core": "~0.1.2",
        "scandiweb/module-magiczoom": "1.1.4",
        "smile/elasticsuite": "~2.9.0",
        "swissup/rtl": "^1.3",
        "swissup/firecheckout": "^1.18"
    },
    "suggest": {
        "ext-pcntl": "Need for run processes in parallel mode"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload": {
        "psr-4": {
            "Magento\\Setup\\": "setup/src/Magento/Setup/",
            "Magento\\": "app/code/Magento/",
            "Zend\\Mvc\\Controller\\": "setup/src/Zend/Mvc/Controller/"
        },
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "component_paths": {
            "trentrichardson/jquery-timepicker-addon": "lib/web/jquery/jquery-ui-timepicker-addon.js",
            "components/jquery": [
                "lib/web/jquery.js",
                "lib/web/jquery/jquery.min.js",
                "lib/web/jquery/jquery-migrate.js"
            ],
            "blueimp/jquery-file-upload": "lib/web/jquery/fileUploader",
            "components/jqueryui": [
                "lib/web/jquery/jquery-ui.js"
            ],
            "twbs/bootstrap": [
                "lib/web/jquery/jquery.tabs.js"
            ],
            "tinymce/tinymce": "lib/web/tiny_mce_4"
        },
        "magento-force": true,
        "magento-deploystrategy": "copy"
    }
}
