{
    "problemMatcher": [
        {
            "owner": "phpunit-teamcity",
            "pattern": [
                {
                    "regexp": "##teamcity\\[testFailed.+message='(.+)'.+details='\\s+{{GITHUB_WORKSPACE}}/([^:]+):(\\d+)[^']+'",
                    "defaultSeverity": "error",
                    "message": 1,
                    "file": 2,
                    "line": 3
                }
            ]
        },
        {
            "owner": "phpmd",
            "pattern": [
                {
                    "regexp": "(app.+):([0-9]+)\\s+(.+)",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            ]
        },
        {
            "owner": "phpcs",
            "severity": "error",
            "pattern": [
                {
                  "regexp": "^<file name=\"(?:\\/github\\/workspace\\/)?(.*)\">$",
                  "file": 1
                },
                {
                  "regexp": "<error line=\"(\\d*)\" column=\"(\\d*)\" severity=\"(error|warning)\" message=\"(.*)\" source=\"(.*)(\"\\/>+)$",
                  "line": 1,
                  "column": 2,
                  "severity": 3,
                  "message": 4,
                  "code": 5,
                  "loop": true
                }
            ]
        }
    ]
}